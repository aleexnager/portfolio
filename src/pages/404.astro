---
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Base title="404 | Alejandro Náger">
  <section class="nf container">
    <p class="mono code">HTTP/1.1 404 Not Found</p>
    <h1>This route does not exist.</h1>
    <p class="muted">Nothing is hidden here. I checked the least significant bits.</p>
    <a class="btn btn-primary" href={base}>Back to the homepage</a>
  </section>
</Base>

<style>
  .nf {
    min-height: 70vh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--s-5);
  }

  .code {
    color: var(--accent);
    font-size: var(--fs-sm);
  }

  h1 {
    font-size: var(--fs-2xl);
  }
</style>
