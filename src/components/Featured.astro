---
import Icon from "./Icon.astro";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<section id="thesis" class="section featured" aria-labelledby="thesis-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="thesis-title">My thesis hides data where an image is noisiest. Try it on my holiday photo.</h2>
      <p>
        Plain LSB steganography is easy to spot when bits land on flat areas like sky. For my bachelor's thesis at UPM I
        ranked image regions by Shannon entropy and embedded there first. This is a live, in-browser version of that idea.
        Nothing leaves your device.
      </p>
    </div>

    <div class="demo card" data-stego data-src={`${base}stego/cover.png`} data-reveal data-i="1">
      <div class="demo-stage">
        <div class="tabs" role="tablist" aria-label="Image view">
          <button role="tab" type="button" aria-selected="true" data-view="image">Image</button>
          <button role="tab" type="button" aria-selected="false" data-view="diff">Changed pixels</button>
          <button role="tab" type="button" aria-selected="false" data-view="entropy">Entropy map</button>
        </div>
        <div class="canvas-wrap" aria-busy="true" data-canvas-wrap>
          <canvas width="256" height="256" data-stego-canvas aria-label="Cover image of a pyramid in Mexico" role="img"></canvas>
          <div class="canvas-loading skeleton" data-canvas-skeleton></div>
          <div class="scanline" aria-hidden="true" data-scanline></div>
        </div>
        <p class="legend" data-legend>The cover image. 256 by 256 pixels, 24,572 bytes of raw LSB capacity.</p>
      </div>

      <form class="demo-panel" data-stego-form novalidate>
        <div class="field">
          <div class="field-row">
            <label for="stego-msg">Secret message</label>
            <span class="mono num counter" data-counter>0 bytes</span>
          </div>
          <textarea id="stego-msg" rows="3" maxlength="280" spellcheck="false" data-msg
            >Open to roles in offensive security, GRC and secure software. Say hi: a.nager@me.com</textarea
          >
        </div>

        <fieldset class="field">
          <legend>Payload</legend>
          <div class="seg" data-seg="payload">
            <label><input type="radio" name="payload" value="message" checked /><span>My message</span></label>
            <label><input type="radio" name="payload" value="bulk" /><span>3 KB stress test</span></label>
          </div>
        </fieldset>

        <fieldset class="field">
          <legend>Algorithm</legend>
          <div class="seg" data-seg="mode">
            <label><input type="radio" name="mode" value="sequential" /><span>Sequential LSB</span></label>
            <label><input type="radio" name="mode" value="adaptive" checked /><span>Entropy-adaptive</span></label>
          </div>
        </fieldset>

        <button type="submit" class="btn btn-primary embed-btn" data-embed disabled>
          <Icon name="lock" />
          <span data-embed-label>Embed message</span>
          <span class="embed-progress" aria-hidden="true" data-progress></span>
        </button>

        <dl class="stats" aria-live="polite">
          <div>
            <dt>Pixels modified</dt>
            <dd class="num" data-stat="pixels">--</dd>
          </div>
          <div>
            <dt>PSNR</dt>
            <dd class="num" data-stat="psnr">--</dd>
          </div>
          <div>
            <dt>Changes in flat areas</dt>
            <dd class="num" data-stat="flat">--</dd>
          </div>
          <div>
            <dt>Capacity used</dt>
            <dd class="num" data-stat="capacity">--</dd>
          </div>
        </dl>

        <div class="extract">
          <button type="button" class="btn btn-ghost btn-sm" data-extract disabled>
            <Icon name="unlock" size="sm" />
            Extract from image
          </button>
          <output class="mono extract-out" data-output>Embed first, then extract it back from the pixels.</output>
        </div>
      </form>
    </div>

    <div class="thesis-foot" data-reveal>
      <p class="muted">
        Full analysis, metrics and tests in Python in the
        <a class="link" href="https://github.com/aleexnager/Staganography-on-images" target="_blank" rel="noopener noreferrer"
          >thesis repository</a
        >.
      </p>
      <ul class="thesis-stack" aria-label="Stack">
        <li class="chip">Python</li>
        <li class="chip">Information theory</li>
        <li class="chip">PSNR and SSIM</li>
        <li class="chip">pytest</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .demo {
    display: grid;
    gap: var(--s-6);
    padding: var(--s-5);
  }

  .demo-stage {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }

  .tabs {
    display: inline-flex;
    gap: 2px;
    width: fit-content;
    max-width: 100%;
    overflow-x: auto;
    padding: 3px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg);
  }

  .tabs button {
    padding: var(--s-1) var(--s-3);
    border-radius: 999px;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    white-space: nowrap;
    transition:
      color var(--dur-2),
      background-color var(--dur-2);
  }

  .tabs button[aria-selected="true"] {
    background: var(--surface-2);
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  .canvas-wrap {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg);
  }

  canvas {
    width: 100%;
    height: 100%;
  }

  .canvas-wrap:global(.is-pixel) canvas {
    image-rendering: pixelated;
  }

  .canvas-loading {
    position: absolute;
    inset: 0;
    border-radius: 0;
  }

  .canvas-wrap:not([aria-busy="true"]) .canvas-loading {
    display: none;
  }

  .scanline {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: var(--accent);
    box-shadow: 0 0 18px 4px rgb(194 242 97 / 0.45);
    opacity: 0;
    pointer-events: none;
  }

  .legend {
    font-size: var(--fs-sm);
    color: var(--text-subtle);
    min-height: 3em;
  }

  .demo-panel {
    display: grid;
    gap: var(--s-5);
    align-content: start;
  }

  .field {
    display: grid;
    gap: var(--s-2);
    border: 0;
    padding: 0;
    min-width: 0;
  }

  .field-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  label,
  legend {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text-muted);
    padding: 0;
  }

  .counter {
    font-size: var(--fs-xs);
    color: var(--text-subtle);
  }

  textarea {
    width: 100%;
    resize: vertical;
    min-height: 5.5rem;
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-md);
    border: 1px solid var(--line-strong);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    line-height: 1.55;
    transition: border-color var(--dur-2);
  }

  textarea:focus {
    outline: none;
    border-color: var(--accent-line);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .seg {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    padding: 3px;
    border-radius: var(--r-md);
    border: 1px solid var(--line);
    background: var(--bg);
  }

  .seg label {
    position: relative;
    margin: 0;
  }

  .seg input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }

  .seg span {
    display: grid;
    place-items: center;
    height: 2.25rem;
    border-radius: calc(var(--r-md) - 3px);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    transition:
      background-color var(--dur-2),
      color var(--dur-2);
  }

  .seg input:checked + span {
    background: var(--surface-2);
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  .seg input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .embed-btn {
    position: relative;
    overflow: hidden;
    width: 100%;
    isolation: isolate;
  }

  .embed-btn:disabled {
    cursor: progress;
  }

  .embed-progress {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #d9f99a;
    transform-origin: left;
    transform: scaleX(0);
  }

  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--line);
  }

  .stats div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--s-3) var(--s-4);
    background: var(--bg-raised);
  }

  .stats dt {
    order: 1;
    font-size: var(--fs-xs);
    color: var(--text-subtle);
  }

  .stats dd {
    font-size: var(--fs-lg);
    font-weight: 550;
    letter-spacing: -0.02em;
  }

  .stats dd:global(.is-good) {
    color: var(--accent);
  }

  .stats dd:global(.is-bad) {
    color: var(--warn);
  }

  .extract {
    display: grid;
    gap: var(--s-3);
  }

  .extract .btn {
    width: fit-content;
  }

  .extract-out {
    display: block;
    min-height: 4.25rem;
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-md);
    border: 1px dashed var(--line-strong);
    font-size: var(--fs-sm);
    color: var(--text-subtle);
    word-break: break-word;
  }

  .extract-out:global(.is-ok) {
    border-style: solid;
    border-color: var(--accent-line);
    color: var(--text);
    background: var(--accent-soft);
  }

  .thesis-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    margin-top: var(--s-5);
  }

  .thesis-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  @media (min-width: 60rem) {
    .demo {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: var(--s-7);
      padding: var(--s-6);
    }
  }
</style>

<script>
  import { initStegoDemo } from "../scripts/stego-ui";
  const root = document.querySelector<HTMLElement>("[data-stego]");
  if (root) initStegoDemo(root);
</script>
