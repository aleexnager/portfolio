  hash: '<path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18"/>',
} as const;

export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
  size?: "sm" | "md";
  class?: string;
  label?: string;
}

const { name, size = "md", class: cls = "", label } = Astro.props;
---

<svg
  class:list={["icon", size === "sm" && "icon-sm", cls]}
  viewBox="0 0 24 24"
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
  role={label ? "img" : undefined}
  set:html={paths[name]}
/>
