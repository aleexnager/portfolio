<style>
  .pv {
    position: relative;
    height: 8.75rem;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
    background:
      radial-gradient(120% 90% at 50% 0%, color-mix(in oklab, var(--tint) 14%, transparent), transparent 70%),
      radial-gradient(circle, rgb(255 255 255 / 0.05) 1px, transparent 1.5px) 0 0 / 14px 14px,
      var(--bg);
    color: var(--text);
  }

  .pv :global(svg),
  .pv :global(canvas) {
    width: 100%;
    height: 100%;
  }

  .pv:not(:global(.is-playing)) :global(*) {
    animation-play-state: paused !important;
  }

  .pv :global(.ln) { fill: none; stroke: rgb(255 255 255 / 0.14); stroke-width: 1.5; }
  .pv :global(.node) { fill: var(--surface-2); stroke: rgb(255 255 255 / 0.18); stroke-width: 1; }
  .pv :global(.blk) { fill: var(--surface-2); stroke: rgb(255 255 255 / 0.14); stroke-width: 1; }
  .pv :global(.shield) { fill: color-mix(in oklab, var(--tint) 20%, transparent); stroke: var(--tint); stroke-width: 1.5; }
  .pv :global(.key) { fill: none; stroke: var(--tint); stroke-width: 2; stroke-linecap: round; }
  .pv :global(.pk) { fill: var(--tint); }
  .pv :global(.lbl) { font: 500 9px var(--font-mono); fill: var(--text-muted); }
  .pv :global(.code) { font: 500 10.5px var(--font-mono); fill: var(--text); }
  .pv :global(.tiny) { font-size: 8.5px; }
