---
import Icon from "./Icon.astro";
import { profile, projects } from "../data/site";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const liveApps = projects.filter((p) => p.live).length;
const start = new Date(profile.careerStart);
const years = ((Date.now() - start.getTime()) / (365.25 * 24 * 3600 * 1000)).toFixed(1);
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <canvas class="field" data-field aria-hidden="true"></canvas>
  <div class="hero-fade" aria-hidden="true"></div>

  <div class="container hero-inner">
    <p class="status" data-reveal>
      <span class="dot" aria-hidden="true"></span>
      <span>{profile.role} at <strong>{profile.company}</strong> ({profile.group}), {profile.location}</span>
    </p>

    <h1 id="hero-title" class="hero-title" data-reveal data-i="1">
      <span data-scramble>Security consultant</span>
      <span class="hero-title-2" data-scramble>who still ships code.</span>
    </h1>

    <p class="hero-lede" data-reveal data-i="2">
      I'm Alejandro Náger, a Cybersecurity Consultant at Minsait (Indra Group) working on identity and access
      management. Before that I assessed cyber risk and ran IT audits at PwC against ENS, NIS2, ISO 27001 and NIST, and
      before that I built .NET applications for pharma. I'm also finishing a master's in offensive and defensive security at UCM.
    </p>

    <div class="hero-cta" data-reveal data-i="3">
      <a class="btn btn-primary" href={`mailto:${profile.email}`}>
        <Icon name="mail" />
        Email me
      </a>
      <a class="btn btn-ghost" href={`${base}${profile.cv}`} download="Alejandro-Nager-CV.pdf">
        <Icon name="download" />
        Download CV
        <span class="mono cta-meta">PDF</span>
      </a>
      <div class="hero-social">
        <a class="icon-btn" href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile">
          <Icon name="linkedin" />
        </a>
        <a class="icon-btn" href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub profile">
          <Icon name="github" />
        </a>
      </div>
    </div>

    <dl class="metrics" data-reveal data-i="4">
      <div class="metric">
        <dt>Years in industry</dt>
        <dd class="num"><span data-years-since={profile.careerStart}>{years}</span></dd>
      </div>
      <div class="metric">
        <dt>Frameworks I audit against</dt>
        <dd class="num">5</dd>
      </div>
      <div class="metric">
        <dt>Apps live in production</dt>
        <dd class="num">{liveApps}</dd>
      </div>
      <div class="metric">
        <dt>Public repositories</dt>
        <dd class="num" data-repo-count aria-busy="true"><span class="skeleton metric-skel"></span></dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - 4rem);
    display: flex;
    align-items: center;
    padding-block: var(--s-9) var(--s-8);
    overflow: hidden;
    isolation: isolate;
  }

  .field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }

  .hero-fade {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(60rem 40rem at 15% 55%, var(--bg) 20%, transparent 70%),
      linear-gradient(180deg, transparent 70%, var(--bg) 100%);
  }

  .hero-inner {
    display: grid;
    gap: var(--s-6);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    width: fit-content;
    padding: var(--s-1) var(--s-4) var(--s-1) var(--s-3);
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgb(12 15 18 / 0.7);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .status strong {
    color: var(--text);
    font-weight: 550;
  }

  .hero-title {
    font-size: var(--fs-display);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.98;
    max-width: 14ch;
  }

  .hero-title span {
    display: block;
  }

  .hero-title-2 {
    color: var(--text-subtle);
  }

  .hero-lede {
    max-width: 38rem;
    font-size: var(--fs-md);
    color: var(--text-muted);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
  }

  .cta-meta {
    font-size: 0.6875rem;
    color: var(--text-subtle);
  }

  .hero-social {
    display: flex;
    gap: var(--s-2);
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    color: var(--text-muted);
    transition:
      color var(--dur-2),
      border-color var(--dur-2),
      background-color var(--dur-2);
  }

  .icon-btn:hover {
    color: var(--text);
    border-color: var(--line-strong);
    background: rgb(255 255 255 / 0.04);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: var(--s-6);
    border-top: 1px solid var(--line);
    max-width: 52rem;
  }

  .metric {
    display: grid;
    grid-template-rows: auto 1fr;
    align-content: start;
    gap: var(--s-2);
    padding: var(--s-5) var(--s-4) 0 0;
  }

  .metric dd {
    grid-row: 1;
  }

  .metric dt {
    font-size: var(--fs-sm);
    color: var(--text-subtle);
  }

  .metric dd {
    font-size: var(--fs-xl);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    min-height: 1em;
  }

  .metric-skel {
    display: block;
    width: 2.5ch;
    height: 0.9em;
  }

  @media (min-width: 48rem) {
    .metrics {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

<script>
  import { initField } from "../scripts/field";
  import { scramble } from "../scripts/scramble";
  initField(document.querySelector<HTMLCanvasElement>("[data-field]"));
  document.querySelectorAll<HTMLElement>("[data-scramble]").forEach((el, i) => scramble(el, 250 + i * 220));
</script>
